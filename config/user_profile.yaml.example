  youtube: https://example.com/my-youtube
  spotify: https://example.com/my-spotify
avatar:
  reference_image: config/user_avatar.jpg
  head_image: config/user_head_transparent.png
  appearance: 任意のキャラクター設定
  vehicle: 任意の乗り物
  scene_constraints: 参照画像の特徴を維持する。
  reference_gallery: ~/Pictures/eyecatches
